# ──────────────────────────────────────────────────────────────────────
# Frontend environment for "שבץ־נא"
#
# Copy this file to `.env.local` and fill in the values. Vite picks up
# `.env.local` automatically; it is git-ignored by default.
#
# When VITE_USE_SUPABASE is "false" or absent, the app runs entirely
# off mockData (current state). Set it to "true" once you've applied
# the migrations in supabase/migrations and created at least one auth
# user that you can sign in as.
# ──────────────────────────────────────────────────────────────────────

# Toggle the Supabase backend on/off. Default: false.
VITE_USE_SUPABASE=false

# Supabase project URL — get from Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon (public) API key — get from Project Settings → API
# NEVER paste the service_role key here.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
